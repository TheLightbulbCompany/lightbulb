{
  "expo": {
    "name": "Lightbulb AI",
    "slug": "isol8-mobile",
    "owner": "isol8",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flickmeon",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2def259d-5e79-462b-9b0f-3d01d666ba66"
    },
    "ios": {
      "bundleIdentifier": "ai.flickmeon.mobile",
      "supportsTablet": false,
      "appleTeamId": "WZX4U3C22Y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Lightbulb AI lets you attach photos from your library to chat messages for your agents."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "associatedDomains": [
        "applinks:flickmeon.ai"
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-iap",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e2dece",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lightbulb AI lets you attach photos from your library to chat messages for your agents.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2def259d-5e79-462b-9b0f-3d01d666ba66"
      }
    }
  }
}
