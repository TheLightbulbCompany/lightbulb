diff --git a/tests/agent/test_lb_checkpoint.py b/tests/agent/test_lb_checkpoint.py
new file mode 100644
index 0000000000000000000000000000000000000000..2570f91c21157a628e38c61875f112925fbf76d8
--- /dev/null
+++ b/tests/agent/test_lb_checkpoint.py
@@ -0,0 +1,186 @@
+"""Lightbulb F1/F2: save-before-effect checkpoint around tool dispatch (spec 02 §4.1, §8.1).
+
+Every test drives the real executor paths with the tool handler mocked at its production
+surface (``model_tools.handle_function_call`` sequential, ``agent._invoke_tool`` concurrent),
+the same way ``test_tool_call_incremental_persistence.py`` does.
+"""
+import json
+import os
+import tempfile
+import threading
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from run_agent import AIAgent
+
+GOLDEN = Path(__file__).parent / "fixtures" / "lb_golden_tool_turn.json"
+
+
+@pytest.fixture(autouse=True)
+def _no_background_titles(monkeypatch):
+    monkeypatch.setattr("agent.title_generator.maybe_auto_title", lambda *a, **k: None)
+
+
+def _make_agent():
+    hermes_home = Path(tempfile.mkdtemp(prefix="hermes-lb-test-"))
+    (hermes_home / "logs").mkdir(parents=True, exist_ok=True)
+    tool_defs = [
+        {"type": "function", "function": {"name": "web_search", "description": "web_search tool",
+                                          "parameters": {"type": "object", "properties": {}}}},
+    ]
+    with (
+        patch("model_tools.get_tool_definitions", return_value=tool_defs),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+        patch("run_agent._hermes_home", hermes_home),
+        patch("agent.model_metadata.fetch_model_metadata", return_value={}),
+    ):
+        agent = AIAgent(api_key="test-key", base_url="https://openrouter.ai/api/v1",
+                        quiet_mode=True, skip_context_files=True, skip_memory=True)
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    agent._flush_messages_to_session_db = MagicMock(return_value=True)
+    return agent
+
+
+def _call(call_id, name="web_search", arguments=None):
+    arguments = arguments or json.dumps({"query": call_id})  # distinct args: identical calls are deduped
+    return SimpleNamespace(id=call_id, type="function", function=SimpleNamespace(name=name, arguments=arguments))
+
+
+def _response(content="", finish_reason="stop", tool_calls=None):
+    msg = SimpleNamespace(content=content, tool_calls=tool_calls)
+    return SimpleNamespace(choices=[SimpleNamespace(message=msg, finish_reason=finish_reason)],
+                           model="test/model", usage=None)
+
+
+def _handler(log):
+    def _fake(function_name, function_args, effective_task_id, **kwargs):
+        log.append(("handler", kwargs.get("tool_call_id")))
+        return f"result-{kwargs.get('tool_call_id')}"
+    return _fake
+
+
+def _invoke(log):
+    def _fake(name, args, task_id, call_id, **kwargs):
+        log.append(("handler", call_id))
+        return f"result-{call_id}"
+    return _fake
+
+
+def _persist_passthrough():
+    return patch("agent.tool_executor.maybe_persist_tool_result", side_effect=lambda **kw: kw["content"])
+
+
+def _run_sequential(agent, call_ids, log):
+    messages: list = []
+    with patch("model_tools.handle_function_call", side_effect=_handler(log)), _persist_passthrough():
+        agent._execute_tool_calls_sequential(
+            SimpleNamespace(content="", tool_calls=[_call(c) for c in call_ids]), messages, "task-1")
+    return messages
+
+
+def _stub_turn(agent, log):
+    """One full turn: the model asks for two tools, then answers."""
+    agent.client.chat.completions.create.side_effect = [
+        _response(finish_reason="tool_calls", tool_calls=[_call("c1"), _call("c2")]),
+        _response(content="done"),
+    ]
+    with (
+        patch("model_tools.handle_function_call", side_effect=_handler(log)),
+        patch.object(agent, "_invoke_tool", side_effect=_invoke(log)),
+        _persist_passthrough(),
+        patch.object(agent, "_persist_session"),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        return agent.run_conversation("search something")
+
+
+class Recorder:
+    """A bridge-shaped callback: logs every call with its thread."""
+
+    def __init__(self, decide=None, commit_error=None, sleep=0.0):
+        self.log = []
+        self.lock = threading.Lock()
+        self.decide = decide
+        self.commit_error = commit_error
+        self.sleep = sleep
+
+    def before_tool(self, ref):
+        from agent.lb_checkpoint import Decision
+        with self.lock:
+            self.log.append(("before_tool", ref.tool_call_id))
+        if self.sleep:
+            time.sleep(self.sleep)
+        return self.decide(ref) if self.decide else Decision.proceed()
+
+    def tool_committed(self, ref, result, disposition):
+        with self.lock:
+            self.log.append(("tool_committed", ref.tool_call_id))
+        if self.commit_error:
+            raise self.commit_error
+
+
+def _canonical(messages):
+    """JSON-normalized messages without wall-clock timestamps."""
+    rows = json.loads(json.dumps(messages, default=str, sort_keys=True))
+    for row in rows:
+        row.pop("timestamp", None)
+    return rows
+
+
+# ---------------------------------------------------------------------------- F1 (module only)
+
+def test_before_tool_without_callback_is_a_noop():
+    from agent import lb_checkpoint
+    agent = SimpleNamespace()
+    ref = lb_checkpoint.ToolRef("t", "x", {})
+    assert lb_checkpoint.before_tool(agent, ref).kind == "proceed"
+    assert lb_checkpoint.tool_committed(agent, ref, "r", None) is True
+    assert not hasattr(agent, "_lb_checkpoint_failed")
+
+
+def test_before_tool_timeout_refuses_and_records():
+    from agent import lb_checkpoint
+    agent = SimpleNamespace()
+    lb_checkpoint.install(agent, Recorder(sleep=0.5), timeout_s=0.05)
+    decision = lb_checkpoint.before_tool(agent, lb_checkpoint.ToolRef("t", "x", {}))
+    assert decision == lb_checkpoint.Decision.refuse("checkpoint_unavailable")
+    assert agent._lb_checkpoint_failed == "TimeoutError"
+
+
+def test_before_tool_raise_refuses_and_records_class():
+    from agent import lb_checkpoint
+
+    def boom(ref):
+        raise ConnectionError("backend down")
+
+    agent = SimpleNamespace()
+    lb_checkpoint.install(agent, Recorder(decide=boom))
+    assert lb_checkpoint.before_tool(agent, lb_checkpoint.ToolRef("t", "x", {})).kind == "refuse"
+    assert agent._lb_checkpoint_failed == "ConnectionError"
+
+
+def test_tool_committed_failure_returns_false():
+    from agent import lb_checkpoint
+    agent = SimpleNamespace()
+    lb_checkpoint.install(agent, Recorder(commit_error=RuntimeError("x")))
+    ref = lb_checkpoint.ToolRef("t", "x", {})
+    lb_checkpoint.before_tool(agent, ref)
+    assert lb_checkpoint.tool_committed(agent, ref, "r", None) is False
+
+
+def test_install_none_uninstalls():
+    from agent import lb_checkpoint
+    agent = SimpleNamespace()
+    lb_checkpoint.install(agent, Recorder())
+    lb_checkpoint.install(agent, None)
+    assert agent._lb_checkpoint is None
