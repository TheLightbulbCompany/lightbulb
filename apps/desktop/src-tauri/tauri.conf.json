{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lightbulb",
  "version": "0.1.0",
  "identifier": "company.thelightbulb.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://thelightbulb.company/chat",
    "frontendDist": "https://thelightbulb.company/chat"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lightbulb",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Visible",
        "dragDropEnabled": false,
        "url": "https://thelightbulb.company/chat"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "bin/lightbulb-browser-service-*",
      "bin/node-*",
      "bin/openclaw-host-*/**/*",
      "bin/chrome-devtools-mcp/**/*",
      "bin/lightbulb"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "Developer ID Application: Prasiddha Parthsarthy (WZX4U3C22Y)",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["flickmeon"]
      }
    },
    "updater": {
      "endpoints": [
        "https://thelightbulb.company/api/desktop/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQkU1QkUxQ0YyMDExNjEKUldSaEVTRFA0VnUraTNOTFNmYmN6cDdLSEFZNk1Ma0VhZ1c0TStTd2tHRW9zT1pRbzUxTWVWZ1gK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
