+# Lightbulb F6: when set, every Codex refresh (singleton and credential pool) asks this delegate
+# instead of the OAuth endpoint. It returns {"access_token", "refresh_token", "last_refresh"} and
+# raises AuthError the way _codex_refresh_failure_error does: a dead grant (broker 410) as
+# _codex_err(msg, "invalid_grant", relogin=True) so the pool quarantines it; busy/5xx/timeout with
+# relogin=False so it does not. None = upstream behavior.
+_REFRESH_DELEGATE: Optional[Callable[[str, str], Dict[str, Any]]] = None
+
+
+_DELEGATE_LOCK = threading.Lock()
+_DELEGATE_LAST: Optional[Tuple[str, Dict[str, Any]]] = None  # (access token refreshed, its result)
+
+
+def set_refresh_delegate(fn: Optional[Callable[[str, str], Dict[str, Any]]]) -> None:
+    global _REFRESH_DELEGATE, _DELEGATE_LAST
+    with _DELEGATE_LOCK:
+        _REFRESH_DELEGATE, _DELEGATE_LAST = fn, None
+
+
+def _delegate_refresh(access_token: str, refresh_token: str) -> Dict[str, Any]:
+    """One broker refresh per stale access token: waiters holding the same token share it (the
+    placeholder refresh token never rotates, so the peer-rotation adopt check cannot fire)."""
+    global _DELEGATE_LAST
+    with _DELEGATE_LOCK:
+        if _DELEGATE_LAST is not None and _DELEGATE_LAST[0] == access_token:
+            return dict(_DELEGATE_LAST[1])
+        out = _REFRESH_DELEGATE(access_token, refresh_token)
+        if not (isinstance(out, dict) and all(
+                isinstance(out.get(k), str) and out[k].strip() for k in ("access_token", "refresh_token"))):
+            raise _codex_err("Lightbulb token broker returned an invalid refresh result.",
+                             "lightbulb_refresh_invalid", relogin=False)
+        _DELEGATE_LAST = (access_token, dict(out))
+        return dict(out)
+
+
 def refresh_codex_oauth_pure(
     access_token: str, refresh_token: str, *, timeout_seconds: float = 20.0) -> Dict[str, Any]:
     """Refresh Codex OAuth tokens without mutating Hermes auth state."""
+    if _REFRESH_DELEGATE is not None:
+        return _delegate_refresh(access_token, refresh_token)
