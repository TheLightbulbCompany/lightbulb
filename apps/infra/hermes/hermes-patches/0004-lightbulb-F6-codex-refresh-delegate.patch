@@ -0,0 +1,192 @@
+"""Lightbulb F6: Codex refresh delegate (spec 13 §4.3, §5.5, §8.1).
+
+With a delegate set, every Codex refresh path (``_refresh_codex_auth_tokens`` and the credential
+pool's ``_post_tokens_refresh``) ends in the delegate instead of the OAuth endpoint, so a VM never
+spends a rotating refresh token itself. Token values are synthetic placeholders.
+"""
+import json
+
+import httpx
+import pytest
+
+from hermes_cli import auth, auth_codex
+
+PLACEHOLDER = "lightbulb-brokered"
+
+
+@pytest.fixture(autouse=True)
+def _reset_delegate():
+    yield
+    auth_codex.set_refresh_delegate(None)
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    """auth.json shaped like a brokered VM: a real access token, the placeholder refresh token."""
+    hermes_home = tmp_path / "hermes"
+    hermes_home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(hermes_home))
+    monkeypatch.setenv("CODEX_HOME", str(tmp_path / "no-codex-cli"))
+    tokens = {"access_token": "vm-at", "refresh_token": PLACEHOLDER}
+    (hermes_home / "auth.json").write_text(json.dumps({
+        "version": 1,
+        "providers": {"openai-codex": {"auth_mode": "chatgpt", "tokens": tokens}},
+        "credential_pool": {"openai-codex": [{
+            "id": "cred-1", "label": "chatgpt", "auth_type": "oauth", "priority": 0,
+            "source": "device_code", **tokens}]},
+    }))
+    return hermes_home / "auth.json"
+
+
+class _Endpoint:
+    """Stands in for the httpx client ``refresh_codex_oauth_pure`` opens."""
+
+    def __init__(self):
+        self.posts = []
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def post(self, url, *, headers=None, data=None):
+        self.posts.append((url, headers, data))
+        return httpx.Response(200, json={"access_token": "http-at", "refresh_token": "http-rt"})
+
+
+@pytest.fixture
+def endpoint(monkeypatch):
+    ep = _Endpoint()
+    monkeypatch.setattr(auth_codex, "_codex_http_client", lambda **kw: ep)
+    return ep
+
+
+def _brokered(calls):
+    def delegate(access_token, refresh_token):
+        calls.append((access_token, refresh_token))
+        return {"access_token": "broker-at", "refresh_token": PLACEHOLDER, "last_refresh": "2026-11-04T00:00:00Z"}
+    return delegate
+
+
+def test_no_delegate_is_byte_identical(endpoint):
+    out = auth_codex.refresh_codex_oauth_pure("at", "rt")
+    assert endpoint.posts == [(
+        auth_codex.CODEX_OAUTH_TOKEN_URL,
+        {"Content-Type": "application/x-www-form-urlencoded"},
+        {"grant_type": "refresh_token", "refresh_token": "rt", "client_id": auth_codex.CODEX_OAUTH_CLIENT_ID},
+    )]
+    assert out["access_token"] == "http-at" and out["refresh_token"] == "http-rt"
+
+
+def test_delegate_replaces_http(home, endpoint):
+    calls = []
+    auth_codex.set_refresh_delegate(_brokered(calls))
+
+    updated = auth._refresh_codex_auth_tokens({"access_token": "vm-at", "refresh_token": PLACEHOLDER}, 5.0)
+    assert updated["access_token"] == "broker-at"
+
+    from agent.credential_pool import load_pool
+    pool = load_pool("openai-codex")
+    entry = pool._post_tokens_refresh(pool.entries()[0])
+    assert entry.access_token == "broker-at" and entry.refresh_token == PLACEHOLDER
+
+    assert endpoint.posts == []
+    assert calls == [("vm-at", PLACEHOLDER), ("broker-at", PLACEHOLDER)]
+
+
+def _failing(relogin):
+    def delegate(access_token, refresh_token):
+        # terminal = the shape _codex_refresh_failure_error gives a dead grant; transient = relogin False
+        code = "invalid_grant" if relogin else "lightbulb_broker_busy"
+        raise auth_codex._codex_err("broker refused the refresh", code, relogin=relogin)
+    return delegate
+
+
+def test_delegate_terminal_quarantines(home, endpoint):
+    from agent.credential_pool import load_pool
+    auth_codex.set_refresh_delegate(_failing(relogin=True))
+    pool = load_pool("openai-codex")
+    assert pool._refresh_entry(pool.entries()[0], force=True) is None
+    assert [e for e in pool.entries() if e.source == "device_code"] == []
+    assert endpoint.posts == []
+
+
+def test_delegate_transient_does_not_quarantine(home, endpoint):
+    from agent.credential_pool import load_pool
+    auth_codex.set_refresh_delegate(_failing(relogin=False))
+    pool = load_pool("openai-codex")
+    pool._refresh_entry(pool.entries()[0], force=True)
+    assert [e.source for e in load_pool("openai-codex").entries()] == ["device_code"]
+    assert endpoint.posts == []
+
+
+def test_placeholder_refresh_token_passes_read(home):
+    assert auth_codex._read_codex_tokens()["tokens"]["refresh_token"] == PLACEHOLDER
+
+
+# ---------------------------------------------------------------------------- review fixes (#12)
+
+def _jwt(exp):
+    import base64
+
+    def part(payload):
+        return base64.urlsafe_b64encode(json.dumps(payload).encode()).decode().rstrip("=")
+    return f"{part({'alg': 'none'})}.{part({'exp': exp})}.sig"
+
+
+@pytest.fixture
+def codex_cli_file(tmp_path, monkeypatch):
+    """A real-looking Codex CLI login on the box: the broker must never let it into the VM."""
+    import time
+    cli = tmp_path / "codex-cli"
+    cli.mkdir()
+    (cli / "auth.json").write_text(json.dumps({"tokens": {
+        "access_token": _jwt(int(time.time()) + 3600), "refresh_token": "REAL-CLI-REFRESH-TOKEN"}}))
+    monkeypatch.setenv("CODEX_HOME", str(cli))
+    return cli
+
+
+def test_delegate_relogin_never_adopts_codex_cli_tokens(home, endpoint, codex_cli_file):
+    auth_codex.set_refresh_delegate(_failing(relogin=True))
+    with pytest.raises(auth.AuthError):
+        auth._refresh_codex_auth_tokens({"access_token": "vm-at", "refresh_token": PLACEHOLDER}, 5.0)
+    assert "REAL-CLI-REFRESH-TOKEN" not in home.read_text()
+
+
+def test_delegate_missing_tokens_recovery_never_adopts_codex_cli_tokens(home, codex_cli_file):
+    auth_codex.set_refresh_delegate(_brokered([]))
+    assert auth_codex._recover_codex_tokens_from_cli("codex_auth_missing_access_token") is None
+    assert "REAL-CLI-REFRESH-TOKEN" not in home.read_text()
+
+
+@pytest.mark.parametrize("bad", [None, {}, {"access_token": ""}, {"access_token": 5, "refresh_token": "x"}, "tok"])
+def test_delegate_return_is_validated(bad):
+    auth_codex.set_refresh_delegate(lambda at, rt: bad)
+    with pytest.raises(auth.AuthError) as info:
+        auth_codex.refresh_codex_oauth_pure("vm-at", PLACEHOLDER)
+    assert info.value.relogin_required is False  # a broken broker reply is not a dead grant
+
+
+def test_concurrent_waiters_share_one_broker_refresh():
+    import threading
+    import time
+    calls = []
+
+    def slow(access_token, refresh_token):
+        calls.append(access_token)
+        time.sleep(0.2)
+        return {"access_token": "broker-at", "refresh_token": PLACEHOLDER, "last_refresh": "t"}
+
+    auth_codex.set_refresh_delegate(slow)
+    results = []
+    threads = [threading.Thread(target=lambda: results.append(
+        auth_codex.refresh_codex_oauth_pure("stale-at", PLACEHOLDER)["access_token"])) for _ in range(4)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(5)
+    assert calls == ["stale-at"]
+    assert results == ["broker-at"] * 4
+    auth_codex.refresh_codex_oauth_pure("broker-at", PLACEHOLDER)  # a newer token refreshes again
+    assert calls == ["stale-at", "broker-at"]
