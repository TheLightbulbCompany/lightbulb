-  // Actions slot — primary "+ New task" + secondary "Mark all as read"
-  // wrapped in the AlertDialog confirmation flow. The Inbox is list-only
-  // (the kanban board lives on the Tasks page), so there is no view-mode
-  // toggle here.
-  const actionsSlot = (
-    <>
-      <EditorialButton
-        type="button"
-        variant="primary"
-        size="sm"
-        onClick={onNewIssue}
-        className="shrink-0"
-      >
-        <Plus size={12} strokeWidth={1.75} />
-        <span>New task</span>
-      </EditorialButton>
-
-      <AlertDialog>
-        <AlertDialogTrigger asChild>
-          <EditorialButton
-            type="button"
-            variant="secondary"
-            size="sm"
-            className="shrink-0"
-            disabled={markDisabled}
-            title={
-              markDisabled
-                ? "No unread items"
-                : `Mark all ${unreadCount} unread as read`
-            }
-          >
-            Mark all as read
-          </EditorialButton>
-        </AlertDialogTrigger>
-        <AlertDialogContent>
-          <AlertDialogHeader>
-            <AlertDialogTitle>Mark all as read?</AlertDialogTitle>
-            <AlertDialogDescription>
-              This will mark {unreadCount} unread{" "}
