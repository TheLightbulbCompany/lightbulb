{
  "name": "@lightbulb/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-neutral core shared by the web and mobile clients: API client, gateway WebSocket protocol, data hooks, and protocol types. No next/*, no react-native, no DOM globals — platform specifics are injected via PlatformAdapter.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cards": "./src/ui/library.ts",
    "./tasks/fixtures": "./src/tasks/fixtures.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "eslint": "^9",
    "jsdom": "^25.0.1",
    "react-dom": "19.2.3",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.1",
    "swr": "^2.3.8",
    "zod": "4.3.6"
  }
}
