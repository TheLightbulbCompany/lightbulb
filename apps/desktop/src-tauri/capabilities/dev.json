{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "dev",
  "description": "Dev flavor only (tauri.dev.conf.json): the dev origin, never in a prod build.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://dev.thelightbulb.company/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "deep-link:default",
    "shell:allow-open",
    "updater:default"
  ]
}
