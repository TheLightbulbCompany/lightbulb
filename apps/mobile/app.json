{
  "expo": {
    "name": "Isol8",
    "slug": "isol8-mobile",
    "owner": "isol8",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isol8",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2def259d-5e79-462b-9b0f-3d01d666ba66"
    },
    "ios": {
      "bundleIdentifier": "co.isol8.mobile",
      "supportsTablet": false,
      "appleTeamId": "WZX4U3C22Y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e2dece",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2def259d-5e79-462b-9b0f-3d01d666ba66"
      }
    }
  }
}
