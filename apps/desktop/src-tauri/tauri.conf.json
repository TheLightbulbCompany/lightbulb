{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Isol8",
  "version": "0.1.0",
  "identifier": "co.isol8.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://dev.isol8.co/chat",
    "frontendDist": "https://dev.isol8.co/chat"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Isol8",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Visible",
        "url": "https://dev.isol8.co/chat"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "bin/isol8-browser-service"
    ],
    "resources": [
      "bin/node-*",
      "bin/openclaw-host-*/**/*"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "Developer ID Application: Prasiddha Parthsarthy (WZX4U3C22Y)",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["isol8"]
      }
    },
    "updater": {
      "endpoints": [
        "https://dev.isol8.co/api/desktop/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQkU1QkUxQ0YyMDExNjEKUldSaEVTRFA0VnUraTNOTFNmYmN6cDdLSEFZNk1Ma0VhZ1c0TStTd2tHRW9zT1pRbzUxTWVWZ1gK"
    }
  }
}
