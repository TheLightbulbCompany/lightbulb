# Clerk Auth (required)
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# OpenClaw Agent Tools (optional)
# Enables web search for agents. Get a key at https://brave.com/search/api/
# BRAVE_API_KEY=BSA...

# OpenClaw image versions (optional). CDK injects these in deployed envs and
# local dev / CI read openclaw-version.json at the repo root automatically.
# Set them only for a non-CDK `docker run --env-file .env` of the backend image,
# where the repo JSON is outside the build context. OPENCLAW_UPSTREAM_VERSION
# also has a hardcoded fallback in core/openclaw_version.py, so leaving it unset
# is safe; the dev/prod tags only drive the admin image-update badges.
# OPENCLAW_UPSTREAM_VERSION=2026.5.12
# OPENCLAW_DEV_TAG=2026.5.12-<sha>
# OPENCLAW_PROD_TAG=2026.5.12-<sha>

# Fernet key for encrypting BYOK API keys at rest (required in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=your-base64-encoded-32-byte-key
