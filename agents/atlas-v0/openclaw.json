{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/agents/atlas/workspace",
      "timeoutSeconds": 600,
      "blockStreamingDefault": "off"
    },
    "list": [
      {
        "id": "atlas",
        "workspace": "~/.openclaw/agents/atlas/workspace",
        "model": "claude-haiku-4-5",
        "thinkingDefault": "low",
        "archetype": "meta-agent-builder",
        "skills": [
          "fast-io",
          "taskr",
          "summarize",
          "n8n-workflow",
          "capability-evolver",
          "skill-vetter",
          "sona-security-audit",
          "agentgate",
          "gog",
          "slack"
        ],
        "tools": {
          "profile": "coding",
          "alsoAllow": ["lobster", "llm-task", "message"]
        }
      }
    ]
  },

  "plugins": {
    "entries": {
      "lobster": { "enabled": true },
      "llm-task": {
        "enabled": true,
        "config": {
          "defaultProvider": "anthropic",
          "defaultModel": "claude-haiku-4-5",
          "maxTokens": 2500,
          "timeoutMs": 60000,
          "note": "Defaults are dev/test fallbacks. Production .lobster pipelines MUST include explicit per-tier provider+model override via $intake.json.tier — see TOOLS.md § Tier-Aware llm-task Routing."
        }
      }
    }
  },

  "skills": {
    "entries": {
      "fast-io": { "enabled": true },
      "taskr": {
        "enabled": true,
        "note": "ClawHub community skill. Invocation surface verified from vera/intake-resolve.lobster, vera/escalation.lobster, ora/scheduling-request.lobster: openclaw.invoke --tool taskr --action {create|read|update} --args-json '{key, data}'."
      },
      "summarize": { "enabled": true },
      "n8n-workflow": { "enabled": true },
      "capability-evolver": { "enabled": true },
      "skill-vetter": { "enabled": true },
      "sona-security-audit": { "enabled": true },
      "agentgate": {
        "enabled": true,
        "note": "ClawHub community skill — installation reference Ember's BOOTSTRAP.md. skill-vetter pre-install required. Used at architecture sign-off (S9), final file write (S10), marketplace submit (S11), and security exception requests during build (A14)."
      },
      "gog": { "enabled": true },
      "slack": { "enabled": true },

      "hubspot-crm": { "enabled": false, "note": "Click-to-connect — Atlas only references when scanning user's installed agents during stack-overlap check." },
      "salesforce-crm": { "enabled": false, "note": "Click-to-connect — read-only for stack-overlap." },
      "attio-crm": { "enabled": false, "note": "Click-to-connect — read-only for stack-overlap." },
      "pipedrive-crm": { "enabled": false, "note": "Click-to-connect — read-only for stack-overlap." }
    }
  },

  "tools": {
    "deny": [
      "salesforce-api",
      "pipedrive-api",
      "attio-api",
      "zoho-recruit",
      "zoho-crm",
      "gmail",
      "mailchimp",
      "fathom-api",
      "tavily",
      "foxreach-io",
      "campaign-orchestrator",
      "phone-caller",
      "linkedin-automation"
    ]
  },

  "cron": {
    "enabled": true,
    "store": "~/.openclaw/cron/jobs.json",
    "maxConcurrentRuns": 2,
    "retry": {
      "maxAttempts": 3,
      "backoffMs": [60000, 120000, 300000],
      "retryOn": ["rate_limit", "overloaded", "network", "server_error"]
    },
    "sessionRetention": "24h"
  },

  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOK_TOKEN}",
    "path": "/hooks"
  },

  "channels": {
    "slack": { "enabled": true }
  }
}
