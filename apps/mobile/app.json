{
  "expo": {
    "name": "Isol8",
    "slug": "isol8-mobile",
    "owner": "isol8",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isol8",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "co.isol8.mobile",
      "supportsTablet": false,
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf7f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2def259d-5e79-462b-9b0f-3d01d666ba66"
      }
    }
  }
}
