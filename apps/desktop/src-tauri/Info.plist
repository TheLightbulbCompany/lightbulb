<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys merged into the generated Info.plist by tauri-bundler
  (bundle.macOS.infoPlist). User keys OVERRIDE generated ones, so keep this
  file to the minimum we actually need — anything added here shadows whatever
  Tauri would have produced.
-->
<plist version="1.0">
<dict>
  <!--
    Opt out of App Nap: the talk key works from any app and a call stays live
    with the window hidden. macOS 26 ignores this key from a bundle; what holds
    is the NSProcessInfo activity `refuse_app_nap` (lib.rs) begins at launch.
    The key stays for a macOS that reads it.
  -->
  <key>NSAppSleepDisabled</key>
  <true/>
  <!--
    Apple Events: Google/Apple sign-in hands off to Safari through osascript
    (lib.rs, oauth-intercept). Under the hardened runtime that needs the
    automation.apple-events entitlement AND this string; without the string
    macOS refuses the event with no prompt (-1743).
  -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Lightbulb opens sign-in pages in Safari.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Lightbulb uses the microphone for voice calls with your agents.</string>
</dict>
</plist>
