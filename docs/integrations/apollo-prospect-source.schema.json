{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isol8.ai/schemas/integrations/apollo-prospect-source.schema.json",
  "title": "Apollo prospect source batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "source_run_id", "prospects"],
  "properties": {
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "description": "LightbulbAI/Paperclip campaign or routine identifier requesting this bounded pilot batch."
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id for the Apollo prospect-source run, used for attribution and replay-safe dedupe."
    },
    "prospects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/prospect" }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "excerpt": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "prospect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apollo_person_id",
        "company_domain",
        "contact",
        "company",
        "enriched_at",
        "quality"
      ],
      "properties": {
        "apollo_person_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable Apollo person id for dedupe and attribution."
        },
        "apollo_organization_id": {
          "type": ["string", "null"],
          "description": "Stable Apollo organization id when present."
        },
        "company_domain": {
          "type": "string",
          "minLength": 1,
          "description": "Normalized company domain used as a second dedupe key."
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "role", "business_email"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "business_email": { "type": ["string", "null"], "format": "email" },
            "linkedin_url": { "anyOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
            "profile_url": { "anyOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] }
          }
        },
        "company": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "website"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "website": { "anyOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
            "description": { "type": ["string", "null"] },
            "category": { "type": ["string", "null"] },
            "headcount": { "type": ["integer", "null"], "minimum": 1 },
            "stage_signals": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "description": "Source URLs and snippets used for personalization and the draft quality gate."
        },
        "suppression_hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apollo_contact_state": { "type": ["string", "null"] },
            "apollo_sequence_state": { "type": ["string", "null"] },
            "prior_contact_observed": { "type": ["boolean", "null"] },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "enriched_at": { "type": "string", "format": "date-time" },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confidence", "flags"],
          "properties": {
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "flags": { "type": "array", "items": { "type": "string" } },
            "rejection_reason": {
              "type": ["string", "null"],
              "description": "Structured reason when the prospect cannot pass the draft quality gate."
            }
          }
        }
      }
    }
  }
}
