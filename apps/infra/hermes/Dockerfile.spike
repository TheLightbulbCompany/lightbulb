# Hermes-on-AgentCore spike image. Not a production image: no version pin on the base, the
# diagnostic hatch in the bridge, no skill binaries yet. See docs/superpowers/plans/2026-09-16-hermes-agentcore-spike.md.
FROM nousresearch/hermes-agent:latest

# Import smoke: the base's own SDK set (anthropic included) must still load Hermes.
RUN python3 -c "from run_agent import AIAgent; print('hermes imports ok')"

COPY bridge /opt/bridge/bridge
COPY plugins/lightbulb /opt/hermes/plugins/lightbulb
# Task 24: bundled agent-facing skills, tool names swapped for Hermes/our plugin's.
# Path matches config.yaml's skills.external_dirs (Task 7).
COPY skills /opt/hermes-skills

# AgentCore runs the container as uid 1000; Hermes state lives under HERMES_HOME.
RUN mkdir -p /opt/data /opt/bridge && chown -R 1000:1000 /opt/data /opt/bridge
USER 1000
WORKDIR /opt/bridge
ENV HERMES_HOME=/opt/data HERMES_HEADLESS=1 PYTHONUNBUFFERED=1 AGENTCORE_PORT=8080
EXPOSE 8080
ENTRYPOINT []
CMD ["python3", "-m", "bridge.server"]

# Managed overlay (Task 11) — non-negotiables an agent's own profile config cannot undo. The
# chown/chmod need root privileges the uid-1000 runtime user above doesn't have, so switch back
# to root for this one step and return to 1000 afterward — the container must still run unprivileged.
USER root
COPY managed/config.yaml /etc/hermes/config.yaml
RUN chown root:root /etc/hermes/config.yaml && chmod 0444 /etc/hermes/config.yaml
USER 1000
