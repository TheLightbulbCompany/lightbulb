+++ b/agent/lb_checkpoint.py
@@ -0,0 +1,132 @@
+"""Lightbulb F1: save-before-effect checkpoint for tool calls (inert by default).
+
+The bridge installs a callback on an agent after construction; until it does,
+``agent._lb_checkpoint`` is None and every function here returns immediately, so the
+patched call sites in ``agent/tool_executor.py`` behave exactly like upstream.
+
+Interface, not policy: which tools pay for an ack is the callback's decision. Unlike
+``pre_tool_call`` hooks (whose failures never block), a callback that raises or times
+out REFUSES the call — fail closed.
+"""
+from __future__ import annotations
+
+import concurrent.futures
+import logging
+from dataclasses import dataclass, field
+import threading
+from typing import Literal, Optional
+
+from tools.thread_context import propagate_context_to_thread
+
+logger = logging.getLogger(__name__)
+
+# ponytail: one shared pool for every agent in the process; a timed-out callback keeps
+# its worker until it returns. Per-agent pools if a wedged backend ever starves this.
+_POOL = concurrent.futures.ThreadPoolExecutor(max_workers=8, thread_name_prefix="lb-checkpoint")
+
+
+class CheckpointRefused(Exception):
+    """Raised by callers that need an exception form of a ``refuse`` decision."""
+
+
+@dataclass(frozen=True)
+class Decision:
+    kind: Literal["proceed", "refuse", "replay"]
+    message: Optional[str] = None
+    result: Optional[str] = None
+
+    @classmethod
+    def proceed(cls) -> "Decision":
+        return cls("proceed")
+
+    @classmethod
+    def refuse(cls, message: str) -> "Decision":
+        return cls("refuse", message=message)
+
+    @classmethod
+    def replay(cls, result: str) -> "Decision":
+        return cls("replay", result=result)
+
+
+_PROCEED = Decision.proceed()
+
+
+@dataclass(frozen=True)
+class ToolRef:
+    tool_call_id: str
+    name: str
+    args: dict = field(hash=False, compare=True)
+
+
+class _Installed:
+    def __init__(self, callback, timeout_s: float) -> None:
+        self.callback = callback
+        self.timeout_s = timeout_s
+        self.lock = threading.Lock()
+        self.open_ids: set = set()  # calls that passed before_tool and still await tool_committed
+
+
+def install(agent, callback, *, timeout_s: float = 10.0) -> None:
+    """Attach ``callback`` (``before_tool(ref) -> Decision``,
+    ``tool_committed(ref, result, disposition) -> None``); ``None`` uninstalls."""
+    agent._lb_checkpoint = None if callback is None else _Installed(callback, timeout_s)
+
+
+def installed(agent) -> bool:
+    return getattr(agent, "_lb_checkpoint", None) is not None
+
+
+def _call(agent, installed: _Installed, method: str, *args):
+    # The turn's ContextVars and approval callbacks follow the call onto the pool thread.
+    future = _POOL.submit(propagate_context_to_thread(getattr(installed.callback, method)), *args)
+    try:
+        return future.result(timeout=installed.timeout_s)
+    except BaseException as exc:  # noqa: BLE001 -- timeout, callback error: both fail closed
+        future.cancel()
+        agent._lb_checkpoint_failed = type(exc).__name__
+        logger.warning("lightbulb checkpoint %s failed: %s", method, type(exc).__name__)
+        raise
+
+
+def before_tool(agent, ref: ToolRef) -> Decision:
+    """``proceed`` when nothing is installed; else the callback's decision, or
+    ``refuse("checkpoint_unavailable")`` when it raises or exceeds ``timeout_s``."""
+    installed = getattr(agent, "_lb_checkpoint", None)
+    if installed is None:
+        return _PROCEED
+    try:
+        decision = _call(agent, installed, "before_tool", ref)
+    except Exception:
+        return Decision.refuse("checkpoint_unavailable")
+    if not isinstance(decision, Decision):
+        agent._lb_checkpoint_failed = "InvalidDecision"
+        return Decision.refuse("checkpoint_unavailable")
+    if decision.kind != "refuse":
+        with installed.lock:
+            installed.open_ids.add(ref.tool_call_id)
+    return decision
+
+
+def forget(agent, ref: ToolRef) -> None:
+    """The call passed before_tool but will not run (interrupted during the ack): no commit."""
+    installed = getattr(agent, "_lb_checkpoint", None)
+    if installed is not None:
+        with installed.lock:
+            installed.open_ids.discard(ref.tool_call_id)
+
+
+def tool_committed(agent, ref: ToolRef, result, disposition) -> bool:
+    """``True`` when nothing is installed, the call never passed ``before_tool`` (skipped,
+    abandoned, timed out before dispatch), or the callback acked; ``False`` on error/timeout."""
+    installed = getattr(agent, "_lb_checkpoint", None)
+    if installed is None:
+        return True
+    with installed.lock:
+        if ref.tool_call_id not in installed.open_ids:
+            return True
+        installed.open_ids.discard(ref.tool_call_id)
+    try:
+        _call(agent, installed, "tool_committed", ref, result, disposition)
+    except Exception:
+        return False
+    return True
