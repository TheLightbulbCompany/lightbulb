{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "qualification-gateway-token"
    }
  },
  "agents": {
    "list": [
      {
        "id": "11111111-1111-4111-8111-111111111111",
        "default": true,
        "workspace": "/tmp/lightbulb-friday"
      },
      {
        "id": "22222222-2222-4222-8222-222222222222",
        "workspace": "/tmp/lightbulb-gauge"
      }
    ]
  },
  "plugins": {
    "entries": {
      "lightbulb": {
        "enabled": true
      }
    }
  },
  "channels": {
    "lightbulb": {
      "enabled": true,
      "accounts": {
        "11111111-1111-4111-8111-111111111111": {
          "enabled": true
        },
        "22222222-2222-4222-8222-222222222222": {
          "enabled": true
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "11111111-1111-4111-8111-111111111111",
      "match": {
        "channel": "lightbulb",
        "accountId": "11111111-1111-4111-8111-111111111111",
        "peer": {
          "kind": "channel",
          "id": "*"
        }
      }
    },
    {
      "agentId": "22222222-2222-4222-8222-222222222222",
      "match": {
        "channel": "lightbulb",
        "accountId": "22222222-2222-4222-8222-222222222222",
        "peer": {
          "kind": "channel",
          "id": "*"
        }
      }
    }
  ],
  "messages": {
    "groupChat": {
      "historyLimit": 50,
      "unmentionedInbound": "room_event",
      "visibleReplies": "automatic"
    }
  },
  "session": {
    "groupScope": "per-group"
  },
  "tools": {
    "profile": "full",
    "allow": [
      "*"
    ],
    "deny": [],
    "sessions": {
      "visibility": "agent"
    },
    "agentToAgent": {
      "enabled": false
    }
  }
}
